# Managed by Ansible (role fail2ban).
# Caddy JSON access log: the client address is request.remote_ip, the status comes after it.
# The second expression covers a log encoder that writes the status first.
[Definition]
failregex = ^.*"remote_ip":"<HOST>".*"status":401\b
            ^.*"status":401\b.*"remote_ip":"<HOST>"
datepattern = "ts":{EPOCH}
