# Managed by Ansible (role podman_monitoring).
{
	admin off
	skip_install_trust
}

http:// {
	redir https://{host}{uri} 308
}

{{ podman_monitoring_caddy_site_addresses | join(', ') }} {
	tls /certs/server.crt /certs/server.key
	log {
		output file /logs/access.log
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	basic_auth {
		{{ podman_monitoring_caddy_basic_auth_user }} {{ podman_monitoring_caddy_basic_auth_hash }}
	}
	handle_path /node_exporter* {
		rewrite * /metrics
		reverse_proxy host.containers.internal:{{ podman_monitoring_node_exporter_listen.split(':')[-1] }}
	}
	handle {
		respond 404
	}
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
}
