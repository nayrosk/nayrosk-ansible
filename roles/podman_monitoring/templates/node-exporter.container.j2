# Managed by Ansible (role podman_monitoring).
[Unit]
Description=Prometheus node_exporter
Wants=network-online.target
After=network-online.target

[Container]
Image=quay.io/prometheus/node-exporter:v{{ podman_monitoring_node_exporter_version }}
Network=host
PodmanArgs=--pid=host --security-opt=apparmor=unconfined
Volume=/:/host:ro,rslave
Volume=/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
Exec=--path.rootfs=/host --collector.systemd --web.listen-address={{ podman_monitoring_node_exporter_listen }}
ReadOnly=true
NoNewPrivileges=true
HealthCmd=wget -q -O /dev/null http://{{ podman_monitoring_node_exporter_listen }}/
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
