#cloud-config
hostname: e2e-fresh
ssh_pwauth: true
disable_root: false
chpasswd:
  expire: false
  users:
    - {name: root, password: e2e-root-password, type: text}
    - {name: ubuntu, password: e2e-ubuntu-password, type: text}
# cloud-init gives ubuntu NOPASSWD sudo. A stock install asks for the password: this rule sorts after
# 90-cloud-init-users and sudo applies the last matching rule, so run 1 needs the become password.
write_files:
  - path: /etc/sudoers.d/99-e2e-ubuntu
    permissions: '0440'
    content: |
      ubuntu ALL=(ALL) ALL
runcmd:
  - [sh, -c, "printf 'PermitRootLogin yes\nPasswordAuthentication yes\n' > /etc/ssh/sshd_config.d/01-e2e-root.conf && systemctl reload ssh"]
